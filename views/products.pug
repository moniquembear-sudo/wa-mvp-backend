extends layout

block content
  section.card
    .header-actions
      h2 Productos
        .filter-container
          //- oninput hace que se ejecute en tiempo real al teclear
          input#filterInput(type="text" placeholder="Buscar en todas las columnas..." oninput="applyFilter()")
    //- Loader de OCR
    #ocrLoader.loader-container(style="display:none")
      .spinner
      span El OCR está analizando nuevas imágenes en segundo plano...

    //- Barra de acciones masivas
    .bulk-actions
      button.btn.btn-primary(type="button" onclick="compartirSeleccionados()") Compartir seleccionados
      button.btn.btn-danger(type="button" onclick="eliminarSeleccionados()") Eliminar seleccionados
      span#selection-count 0 seleccionados

    .table-container
      table.product-table
        thead
          tr
            th
              input(type="checkbox" id="selectAll" onchange="toggleAll(this)")
            th Foto
            th(onclick="sortTable('group')") Grupo ⇅
            th(onclick="sortTable('category')") Categoría 
              span#ind-category.indicator
            th(onclick="sortTable('price')") Precio 
              span#ind-price.indicator
            th(onclick="sortTable('date')") Fecha ⇅
            th Acciones
        tbody#productBody
          //- Se llena vía AJAX

  //- Modal para agrandar imagen
  div#imageModal.modal(style="display:none")
    span.close &times;
    img#modalImage.modal-content

  script(src="/products.js")